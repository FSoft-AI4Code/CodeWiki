# Copy to config.env (git-ignored) and fill in.
# Keys are `codewiki config set` option names without the leading --
# (run `codewiki config set --help` for the full list). Empty values are skipped.
# true -> --key, false -> --no-key (for --x/--no-x options like use-gitignore).

api-key =
base-url = https://openrouter.ai/api/v1
provider = openai-compatible
main-model =
cluster-model =
fallback-model =
max-tokens = 32768
max-token-per-module = 36369
max-token-per-leaf-module = 16000
max-depth = 2
concurrency = 4
# request-limit = 100
# max-context-tokens = 0
# prompt-caching = true

[generate]
# Extra `codewiki generate` options, added to both the first run and the --update run.
# artifact-token-budget = 20000
# exclude = *tests*,docs/*
