# Copy to .env in the project root, or set CODEWIKI_REPO in your shell.
# Use an absolute path to the Git repository you want to document.
# The default (..) is relative to docker/docker-compose.yml: CodeWiki itself.
CODEWIKI_REPO=..

# Configure the provider using `docker compose ... run --rm codewiki config set`.
# CLI configuration persists in the codewiki-config volume; the container uses
# file-based credential storage because a system keyring is unavailable.
# The former web app's APP_PORT and LLM_* environment settings are not used.
